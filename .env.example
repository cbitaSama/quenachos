# Cliente — público (NEXT_PUBLIC_)
NEXT_PUBLIC_WHATSAPP_NUMBER=59177376341
NEXT_PUBLIC_INSTAGRAM_URL=https://www.instagram.com/quenachos.bo
NEXT_PUBLIC_TIKTOK_URL=https://www.tiktok.com/@quenachos.bo
NEXT_PUBLIC_SITE_URL=https://quenachos.vercel.app

# Maps embed — público
NEXT_PUBLIC_PICKUP_LAT=-17.741248
NEXT_PUBLIC_PICKUP_LNG=-63.178774

# ── Admin (/admin) — Supabase "Vectoria Space" ──────────────────────────────
# Auth del dueño (Supabase Auth). La anon/publishable key es pública.
NEXT_PUBLIC_SUPABASE_URL=https://mlqoivapndrvmebgnwyd.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Datos del negocio (schema quenachos vía funciones puente public.qn_*) — SECRETO.
# Supabase → Settings → API Keys → key "service_role" (o "secret") → Reveal/Copy.
# NUNCA con prefijo NEXT_PUBLIC_, nunca al cliente. En Vercel va como secreta.
SUPABASE_SERVICE_ROLE_KEY=

# Allowlist de admins (emails separados por coma). Si está vacía, cualquier
# sesión válida entra → en producción poné acá el/los correos del dueño Y
# deshabilitá signups en Supabase → Auth → Providers → Email → "Allow sign-ups".
ADMIN_EMAILS=

# WAHA — para que el panel le avise al cliente por WhatsApp al confirmar el pago.
# Mismo número/sesión del bot Nachito. La API key es secreta (no NEXT_PUBLIC_).
WAHA_URL=https://waha.vectoria.space
WAHA_SESSION=Nachito
WAHA_API_KEY=
